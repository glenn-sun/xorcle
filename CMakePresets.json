{
    "version": 6,
    "configurePresets": [
        {
            "name": "release",
            "displayName": "Release",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "binaryDir": "${sourceDir}/build-debug",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "profile",
            "displayName": "Profile",
            "binaryDir": "${sourceDir}/build-profile",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "dev",
            "displayName": "Debug with warnings as errors",
            "binaryDir": "${sourceDir}/build-dev",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "XORCLE_WERROR": "ON" }
        },
        {
            "name": "sanitize",
            "displayName": "Debug under ASan and UBSan",
            "binaryDir": "${sourceDir}/build-sanitize",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "release",
            "configurePreset": "release",
            "configuration": "Release"
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "configuration": "Debug"
        },
        {
            "name": "profile",
            "configurePreset": "profile",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "dev",
            "configurePreset": "dev",
            "configuration": "Debug"
        },
        {
            "name": "sanitize",
            "configurePreset": "sanitize",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "release",
            "configurePreset": "release",
            "configuration": "Release"
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "configuration": "Debug"
        },
        {
            "name": "dev",
            "configurePreset": "dev",
            "configuration": "Debug"
        },
        {
            "name": "sanitize",
            "configurePreset": "sanitize",
            "configuration": "Debug",
            "environment": {
                "ASAN_OPTIONS": "detect_leaks=1",
                "LSAN_OPTIONS": "suppressions=${sourceDir}/tests/lsan.supp",
                "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
            }
        }
    ]
}
