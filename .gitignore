# Build output. The glob covers the alternate-configuration trees that
# `cmake -B build-debug` and friends produce alongside the default one.
/build*/
/out/
/_deps/

# In-source configure leftovers, for when someone runs `cmake .` by mistake.
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
cmake_install.cmake
Makefile

# Generated by CMAKE_EXPORT_COMPILE_COMMANDS; machine-specific absolute paths.
compile_commands.json

# Machine-local presets; CMakeUserPresets.json.example shows the pattern.
CMakeUserPresets.json

# Benchmark instances, none committed
/benchmarks/generated/
/benchmarks/external/

# Generated documentation
/docs/html/
/docs/latex/

# Python
/.venv/
__pycache__/
*.pyc

# Editor, tooling and OS
/.vscode/
/.idea/
/.cache/
.DS_Store

# Proofs and profiling artifacts
*.lrup
*.dSYM/
profile.json
perf.data*
*.profraw
*.profdata
callgrind.out.*

# Paper
/paper/