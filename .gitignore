# Build output. The glob covers the alternate-configuration trees that
# `cmake -B build-debug` and friends produce alongside the default one.
/build*/
/out/
/_deps/
/CMakeFiles/
/tests/CMakeFiles/
*.cmake
Makefile
/tests/Makefile
CMakeCache.txt

# Generated test instances (see tests/manifest.csv)
/tests/generated/

# Generated documentation
/docs/html/
/docs/latex/

# Python
/.venv/
__pycache__/
*.pyc

# Editor and OS
/.vscode/
.DS_Store

# Proofs and profiling artifacts
*.lrup
*.dSYM/
