# Doxygen configuration for Xorcle.
#
# Convention: this file lists only the settings that differ from Doxygen's
# defaults. To see a default, run `doxygen -g` into a scratch file and look it
# up there.
#
# Relative paths are resolved against the working directory, not this file's
# location, so run it from the repository root:
#
#     doxygen docs/Doxyfile

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------

PROJECT_NAME           = Xorcle
PROJECT_BRIEF          = "A SAT solver for XNF formulas, where clauses are disjunctions of linear equations modulo 2"

OUTPUT_DIRECTORY       = docs

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------

INPUT                  = src
RECURSIVE              = YES

# The default patterns already cover *.h and *.cpp. The X-macro tables,
# `cli/options.inc` and `util/stats_fields.inc`, are deliberately left out:
# Doxygen has no way to read one, and adding *.inc turns each `XORCLE_OPTION(...)`
# or `XORCLE_STAT(...)` row into an invented function or variable in the output.
# Each table documents itself in its own @file comment, which the header that
# includes it refers to.

# Show `io/dimacs.h` rather than `src/io/dimacs.h`; `src` is the include root
# the library exports, so paths already read that way in the source.
STRIP_FROM_PATH        = src

#---------------------------------------------------------------------------
# What to extract
#---------------------------------------------------------------------------

# Private members and file-local helpers carry doc comments in this tree.
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

# Declaration order in these headers is deliberate (construction, then queries,
# then mutators, then the private state they act on). Alphabetizing loses it.
SORT_MEMBER_DOCS       = NO

#---------------------------------------------------------------------------
# Diagnostics
#---------------------------------------------------------------------------

# Progress chatter off, warnings still on: the point of running Doxygen in this
# tree is to find doc comments that no longer match their code.
QUIET                  = YES

# Coverage warnings off, drift warnings on: a doc comment may leave a
# self-explanatory parameter silent, but a `@param` naming no parameter, which is
# what a signature change that outran its comment looks like, is reported
# (WARN_IF_DOC_ERROR, on by default).
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO

#---------------------------------------------------------------------------
# Output formats
#---------------------------------------------------------------------------

# HTML only. LaTeX is on by default and nothing here wants a PDF.
GENERATE_LATEX         = NO

# Doc comments carry @f$...@f$ math. By default Doxygen renders each formula to
# an image by shelling out to latex and dvips, which fails on a machine without
# a TeX installation. MathJax renders them in the browser instead, so building
# the reference needs nothing beyond Doxygen itself.
USE_MATHJAX            = YES
